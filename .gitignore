# ==========================================
# CredChain — Git Ignore Rules
# ==========================================

# 1. Environment Files & Local Secrets (CRITICAL)
.env
.env.*
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# 2. Cryptographic Keys & Certificates
*.pem
*.key
*.pkcs12
*.p12
*.pfx
id_rsa
id_ed25519
*.keystore

# 3. Dependencies
node_modules/
.pnp
.pnp.js

# 4. Production Builds & Compiled Assets
dist/
build/
out/
.next/

# 5. Blockchain & Hardhat Compilation Artifacts
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
coverage/
coverage.json
.openzeppelin/

# 6. Database / Local Storage
*.sqlite
*.sqlite3
*.db

# 7. IDE, Editor, & System Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 8. Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
backend/scratch/
scratch/
