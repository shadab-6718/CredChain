# ==========================================
# CredChain Environment Configuration
# ==========================================

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (Backend Admin & API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Pinata IPFS (Secure Off-chain Document Storage)
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key
PINATA_JWT=your-pinata-jwt-token
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Polygon Amoy Testnet (Chain ID: 80002)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=your-deployer-private-key-without-0x
CREDCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ==========================================
# FRONTEND CONFIGURATION (Vite)
# ==========================================
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_CREDCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
