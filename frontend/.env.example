# ==========================================
# CredChain Frontend Configuration Template
# Copy this file to .env and configure values
# ==========================================

# Backend API URL (Proxied through Vite on http://localhost:5173 or direct)
VITE_API_URL=/api

# Supabase Configuration (Public Anon Key only - Never place Service Role key here!)
# Find in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Blockchain Configuration (Polygon Amoy Testnet)
VITE_POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
VITE_CREDCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# IPFS Pinata Gateway (Public Gateway)
VITE_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
